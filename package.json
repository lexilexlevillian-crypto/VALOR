{
  "name": "valor",
  "version": "0.2.0-alpha",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "check": "tsc --noEmit",
    "test": "node tests/run.ts",
    "migrate": "node --env-file-if-exists=.env src/cli.ts migrate",
    "backup": "node --env-file-if-exists=.env src/cli.ts backup",
    "db:import": "node --env-file-if-exists=.env src/cli.ts import-sqlite",
    "user:create": "node --env-file-if-exists=.env src/cli.ts user:create"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "24.19.0",
    "typescript": "5.9.3"
  }
}
