{
  "name": "valor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "migrate": "node --env-file-if-exists=.env src/cli.ts migrate",
    "backup": "node --env-file-if-exists=.env src/cli.ts backup",
    "user:create": "node --env-file-if-exists=.env src/cli.ts user:create"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "5.9.3"
  }
}
