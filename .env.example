NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/valor.sqlite
# Local development uses SQLite when both Turso variables are unset.
# Production requires both; enter real values privately in Render, never in Git.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# Set a random secret of at least 32 characters in production (never commit it).
# RATE_LIMIT_SECRET=
# Public signup creates players only; provision Creator accounts with user:create.
# Optional trusted HTTPS narration gateway. Both campaign budgets must also be enabled.
# AI_GATEWAY_URL=
# AI_GATEWAY_SECRET=
# Direct Gemini support: use the existing private Render key, never a committed key.
# GEMINI_API_KEY=
# GOOGLE_API_KEY= (alternative name; GEMINI_API_KEY takes precedence)
# GEMINI_MODEL=gemini-3.8-flash
# Gemini is selected automatically when available; choose grounded to opt out.
# Both campaign and user AI budgets must be nonzero before external requests.
# Explicit Gemini action proposals share these budgets and always need confirmation.
# Render production: APP_ORIGIN=https://valor-uwgb.onrender.com
# Render production uses Turso; DATABASE_PATH is ignored and no disk is required.
