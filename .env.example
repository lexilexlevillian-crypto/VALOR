NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/valor.sqlite
# Local development uses SQLite when both Turso variables are unset.
# Production requires both; enter real values privately in Render, never in Git.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# Set a random secret of at least 32 characters in production (never commit it).
# RATE_LIMIT_SECRET=
# Optional bounded security limits. Defaults shown.
# REQUEST_LIMIT=120
# LOGIN_LIMIT=10
# MUTATION_LIMIT=60
# AI_CALL_LIMIT=10
# EXPORT_LIMIT=10
# EXPORT_MAX_BYTES=8388608
# IMPORT_MAX_BYTES=8388608
# Optional server-only key that lets an authenticated user deliberately unlock
# Developer Mode and Creator access for campaigns where they are already a member.
# Use a random 32-256 character value. Never put the real key in source or client code.
# DEVELOPER_ACCESS_KEY=
# Optional separate administrator-issued key for the Forgot password flow.
# Recovery changes the password, revokes every session, and is audited.
# Use a random 32-256 character value distinct from DEVELOPER_ACCESS_KEY.
# PASSWORD_RECOVERY_KEY=
# Public signup creates players only; provision Creator accounts with user:create.
# Optional trusted HTTPS narration gateway. Both campaign budgets must also be enabled.
# AI_GATEWAY_URL=
# AI_GATEWAY_SECRET=
# Direct Gemini support: use the existing private Render key, never a committed key.
# AI_STARTUP_CHECK=off (optional: disable the small synthetic Gemini check on server startup)
# GEMINI_API_KEY=
# GOOGLE_API_KEY= (alternative name; GEMINI_API_KEY takes precedence)
# GEMINI_MODEL=gemini-3.8-flash
# Optional purpose-specific routes; GEMINI_MODEL is the fallback for the first three.
# GEMINI_NARRATION_MODEL=gemini-3.8-flash
# GEMINI_CLASSIFICATION_MODEL=gemini-3.8-flash
# GEMINI_EXTRACTION_MODEL=gemini-3.8-flash
# GEMINI_CREATOR_MODEL=gemini-3.8-flash (enables optional Creator assistance)
# Gemini is selected automatically when available; choose grounded to opt out.
# Both campaign and user AI budgets must be nonzero before external requests.
# Explicit Gemini action proposals share these budgets and always need confirmation.
# Render production: APP_ORIGIN=https://valor-uwgb.onrender.com
# Render production uses Turso; DATABASE_PATH is ignored and no disk is required.
