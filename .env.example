NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/valor.sqlite
# Set a random secret of at least 32 characters in production (never commit it).
# RATE_LIMIT_SECRET=
# Accounts are provisioned through user:create; no open registration or defaults.
# Optional trusted HTTPS narration gateway. Both campaign budgets must also be enabled.
# AI_GATEWAY_URL=
# AI_GATEWAY_SECRET=
# Render production: APP_ORIGIN=https://valor-uwgb.onrender.com
# DATABASE_PATH=/var/data/valor.sqlite (requires a verified persistent disk)
